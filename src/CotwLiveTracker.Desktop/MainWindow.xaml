<Window x:Class="CotwLiveTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CotwLiveTracker.Desktop.Controls"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="WildTrace — COTW Scanner"
        Width="1540"
        Height="920"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Global chrome -->
        <Border Grid.Row="0"
                Background="#0E100D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            Background="{StaticResource AccentMuted}"
                            BorderBrush="#58401F"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,12,0">
                        <fa:IconBlock Icon="Crosshairs"
                                      Foreground="{StaticResource AccentBright}"
                                      FontSize="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WILDTRACE"
                                   FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock Text="COTW SCANNER"
                                   Foreground="{StaticResource TextFaint}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            Background="#171A14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="{StaticResource ControlGap}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource TextFaint}"
                                     Margin="{StaticResource InlineGap}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Offline"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Grid Width="286" Margin="{StaticResource ControlGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:IconBlock Icon="Map"
                                      Foreground="{StaticResource AccentBrush}"
                                      FontSize="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Panel.ZIndex="2"/>
                        <ComboBox x:Name="ReserveBox"
                                  Grid.ColumnSpan="2"
                                  Padding="32,6,10,6"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ReserveBox_SelectionChanged"/>
                    </Grid>

                    <Button x:Name="AttachButton"
                            Style="{StaticResource PrimaryButton}"
                            Click="AttachButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plug" FontSize="12" Margin="{StaticResource InlineGap}"/>
                            <TextBlock Text="Attach"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="MainTabs"
                    TabStripPlacement="Left"
                    SelectedIndex="1">
            <!-- Kept only for existing session bindings; intentionally hidden from navigation. -->
            <TabItem Header="Dashboard" Visibility="Collapsed">
                <Grid Visibility="Collapsed">
                    <TextBlock x:Name="LoadedCountText"/>
                    <TextBlock x:Name="ResolvedCountText"/>
                    <TextBlock x:Name="DiamondCountText"/>
                    <TextBlock x:Name="RareCountText"/>
                    <TextBlock x:Name="GreatOneCountText"/>
                    <TextBlock x:Name="DashboardReserveText"/>
                    <TextBlock x:Name="CameraPositionText"/>
                    <TextBlock x:Name="PopulationTotalText"/>
                    <TextBlock x:Name="RuntimeStatusText"/>
                    <DataGrid x:Name="DashboardAnimalsGrid"/>
                </Grid>
            </TabItem>

            <!-- LIVE MAP -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Map" FontSize="13" Width="20" Margin="{StaticResource InlineGap}"/>
                        <TextBlock Text="LIVE MAP"/>
                    </StackPanel>
                </TabItem.Header>

                <!--
                    Live Map is intentionally map-first. Filters and telemetry float over
                    the reserve instead of splitting the page into dashboard columns.
                -->
                <Grid Background="#080A07"
                      ClipToBounds="True">

                    <controls:RadarControl x:Name="Radar"
                                                   SafeInsetLeft="270"
                                                   SafeInsetTop="24"
                                                   SafeInsetRight="428"
                                                   SafeInsetBottom="24"/>

                    <!-- Viewport vignette: the visible reserve dissolves into the app
                         shell even when the image is zoomed beyond its literal edges. -->
                    <Border IsHitTestVisible="False"
                            Width="92"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#F2080A07" Offset="0"/>
                                <GradientStop Color="#9E080A07" Offset="0.38"/>
                                <GradientStop Color="#00080A07" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border IsHitTestVisible="False"
                            Width="92"
                            HorizontalAlignment="Right">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00080A07" Offset="0"/>
                                <GradientStop Color="#9E080A07" Offset="0.62"/>
                                <GradientStop Color="#F2080A07" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border IsHitTestVisible="False"
                            Height="66"
                            VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#D9080A07" Offset="0"/>
                                <GradientStop Color="#00080A07" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border IsHitTestVisible="False"
                            Height="74"
                            VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00080A07" Offset="0"/>
                                <GradientStop Color="#E6080A07" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Small map state tag -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="270,20,428,0"
                            Padding="10,6"
                            Background="#DC0D100C"
                            BorderBrush="#76353B30"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center"
                                     Margin="{StaticResource InlineGap}"/>
                            <TextBlock x:Name="MapModeStatusText"
                                       Text="Reserve map"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                       FontWeight="SemiBold"
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- FILTER INSTRUMENT -->
                    <Border Width="232"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Margin="{StaticResource PageGutter}"
                            Padding="{StaticResource PanelPadding}"
                            Background="#ED0D100C"
                            BorderBrush="#8A343A2F"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.25"
                                              Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <fa:IconBlock Icon="Sliders"
                                                      Foreground="{StaticResource AccentBrush}"
                                                      FontSize="11"
                                                      Margin="{StaticResource InlineGap}"
                                                      VerticalAlignment="Center"/>
                                        <TextBlock Text="FILTER ANIMALS"
                                                   FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="Display only · scanner stays live"
                                               Foreground="{StaticResource TextFaint}"
                                               FontSize="9"
                                               Margin="19,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LiveFilterSummaryText"
                                           Grid.Column="1"
                                           Text="0 / 0"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,16">
                                <fa:IconBlock Icon="MagnifyingGlass"
                                              Foreground="{StaticResource TextFaint}"
                                              FontSize="10"
                                              Margin="10,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Panel.ZIndex="2"/>
                                <TextBox x:Name="LiveSearchFilter"
                                         Padding="30,6,10,6"
                                         ToolTip="Search species, fur, trophy, sex or level"
                                         TextChanged="LiveFilters_Changed"/>
                                <TextBlock Text="Search loaded animals"
                                           Foreground="{StaticResource TextFaint}"
                                           FontSize="10"
                                           Margin="30,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=LiveSearchFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="SPECIES" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveSpeciesFilter"
                                              Margin="{StaticResource FieldGap}"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="TROPHY" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveTrophyFilter"
                                              Margin="{StaticResource FieldGap}"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="DIFFICULTY" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveDifficultyFilter"
                                              Margin="{StaticResource FieldGap}"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="FUR TYPE" Style="{StaticResource SectionLabel}"/>
                                    <TextBox x:Name="LiveFurFilter"
                                             Margin="{StaticResource FieldGap}"
                                             ToolTip="Filter by fur name"
                                             TextChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="SEX" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveSexFilter"
                                              Margin="{StaticResource FieldGap}"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,0,0,14"/>

                                    <CheckBox x:Name="LiveRareOnly"
                                              Content="Rare fur only"
                                              Margin="0,0,0,10"
                                              Checked="LiveFilters_Changed"
                                              Unchecked="LiveFilters_Changed"/>
                                    <CheckBox x:Name="LiveGreatOneOnly"
                                              Content="Great One only"
                                              Margin="0,0,0,16"
                                              Checked="LiveFilters_Changed"
                                              Unchecked="LiveFilters_Changed"/>

                                    <WrapPanel x:Name="ActiveFilterChipsPanel"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="NoActiveFiltersText"
                                               Text="No active filters"
                                               Foreground="{StaticResource TextFaint}"
                                               FontSize="9"
                                               Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="3"
                                    Style="{StaticResource QuietButton}"
                                    HorizontalContentAlignment="Left"
                                    Padding="0,8,0,0"
                                    Click="ClearLiveFilters_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Rotate"
                                                  FontSize="9"
                                                  Margin="{StaticResource InlineGap}"/>
                                    <TextBlock Text="Reset filters"
                                               FontSize="10"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- TARGET / POPULATION INSTRUMENT -->
                    <Border Width="390"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="{StaticResource PageGutter}"
                            Background="#ED0D100C"
                            BorderBrush="#8A343A2F"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.25"
                                              Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Selected target -->
                            <Grid Grid.Row="0"
                                  Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectedAccentBar"
                                        Grid.Column="0"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="6,0,0,0"/>

                                <Grid Grid.Column="1"
                                      Margin="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <fa:IconBlock Icon="Crosshairs"
                                                              Foreground="{StaticResource TextFaint}"
                                                              FontSize="9"
                                                              Margin="{StaticResource InlineGap}"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="TARGET INSPECTOR"
                                                           Foreground="{StaticResource TextFaint}"
                                                           FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                           FontWeight="SemiBold"
                                                           FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SelectedAnimalTitle"
                                                       Text="Select an animal"
                                                       FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                       FontWeight="SemiBold"
                                                       FontSize="23"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock x:Name="SelectedDistanceText"
                                                       Text="Click a map marker or loaded animal"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="10"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <Button x:Name="FollowSelectedAnimalButton"
                                                Grid.Column="1"
                                                Style="{StaticResource PrimaryButton}"
                                                Width="40"
                                                Height="38"
                                                Padding="0"
                                                IsEnabled="False"
                                                Click="FollowSelectedAnimalButton_Click"
                                                ToolTip="Follow selected animal">
                                            <fa:IconBlock Icon="LocationCrosshairs"
                                                          FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="SelectedBadgesPanel"
                                                Grid.Row="1"
                                                Orientation="Horizontal"
                                                Margin="0,16,0,16"
                                                Visibility="Collapsed">
                                        <Border Background="#1B1E18"
                                                BorderBrush="#41483A"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4"
                                                Margin="{StaticResource InlineGap}">
                                            <TextBlock x:Name="SelectedGenderText"
                                                       Text="—"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#1B1E18"
                                                BorderBrush="#41483A"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4"
                                                Margin="{StaticResource InlineGap}">
                                            <TextBlock x:Name="SelectedDifficultyText"
                                                       Text="—"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border x:Name="SelectedTrophyBadge"
                                                Background="#1B1E18"
                                                BorderBrush="{StaticResource BorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4">
                                            <TextBlock x:Name="SelectedTrophyText"
                                                       Text="—"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <Grid x:Name="SelectedMetricsGrid"
                                          Grid.Row="2"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Margin="0,4,16,16">
                                            <TextBlock Text="TROPHY SCORE" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedScoreText"
                                                       Text="—"
                                                       Style="{StaticResource MetricValue}"
                                                       FontSize="21"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Grid.RowSpan="3"
                                                Background="{StaticResource BorderBrush}"/>
                                        <StackPanel Grid.Column="2"
                                                    Margin="16,4,0,16">
                                            <TextBlock Text="WEIGHT" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedWeightText"
                                                       Text="—"
                                                       Style="{StaticResource MetricValue}"
                                                       FontSize="21"/>
                                        </StackPanel>

                                        <Border Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                Background="{StaticResource BorderBrush}"/>

                                        <StackPanel Grid.Row="2"
                                                    Margin="0,16,16,0">
                                            <TextBlock Text="FUR TYPE" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedFurText"
                                                       Text="—"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="2"
                                                    Margin="16,16,0,0">
                                            <TextBlock Text="HEALTH" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedHealthText"
                                                       Text="—"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="SelectedFooterPanel"
                                                Grid.Row="3"
                                                Visibility="Collapsed"
                                                Margin="0,14,0,0">
                                        <Border Background="#241A0E"
                                                BorderBrush="#4A351C"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,8">
                                            <TextBlock x:Name="SelectedThresholdText"
                                                       Text="Trophy threshold context"
                                                       Foreground="#E8C68E"
                                                       FontSize="9"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <Expander x:Name="SelectedTechnicalPanel"
                                                  Header="Developer details"
                                                  Visibility="Collapsed"
                                                  Margin="0,8,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="SelectedTechnicalText"
                                                           Text="—"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"/>
                                                <Button Content="Probe native level"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        Click="ProbeDifficultyButton_Click"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{StaticResource BorderBrush}"/>

                            <!-- Loaded target list -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <fa:IconBlock Icon="Paw"
                                                      Foreground="{StaticResource AccentBrush}"
                                                      FontSize="10"
                                                      Margin="{StaticResource InlineGap}"/>
                                        <TextBlock Text="LOADED ANIMALS"
                                                   FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="DOUBLE-CLICK TO FOLLOW"
                                               Foreground="{StaticResource TextFaint}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="NoLoadedAnimalsText"
                                               Text="ATTACH TO COTW TO SCAN LOADED ANIMALS"
                                               Foreground="{StaticResource TextFaint}"
                                               FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                               FontSize="9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <DataGrid x:Name="LiveAnimalsGrid"
                                              Background="Transparent"
                                              SelectionMode="Single"
                                              SelectionChanged="LiveAnimalsGrid_SelectionChanged"
                                              MouseDoubleClick="LiveAnimalsGrid_MouseDoubleClick"
                                              HeadersVisibility="None"
                                              RowHeight="54"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#20251D"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,4,12,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="3"
                                                                    Margin="0,4,0,4"
                                                                    Background="{Binding AccentBrush}"
                                                                    CornerRadius="2"/>

                                                            <StackPanel Grid.Column="1"
                                                                        Margin="12,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplaySpecies}"
                                                                           FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding Difficulty}"
                                                                               Foreground="{StaticResource TextSecondary}"
                                                                               FontSize="9"/>
                                                                    <TextBlock Text="  ·  "
                                                                               Foreground="{StaticResource TextFaint}"
                                                                               FontSize="9"/>
                                                                    <TextBlock Text="{Binding Trophy}"
                                                                               Foreground="{Binding AccentBrush}"
                                                                               FontSize="9"
                                                                               FontWeight="SemiBold"/>
                                                                    <TextBlock Text="  ·  "
                                                                               Foreground="{StaticResource TextFaint}"
                                                                               FontSize="9"/>
                                                                    <TextBlock Text="{Binding Fur}"
                                                                               Foreground="{StaticResource TextFaint}"
                                                                               FontSize="9"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DistanceText}"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Following state -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="270,60,428,0"
                            Padding="10,6"
                            Background="#E80D100C"
                            BorderBrush="#74413B2B"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="LocationCrosshairs"
                                          Foreground="{StaticResource AccentBrush}"
                                          FontSize="9"
                                          Margin="{StaticResource InlineGap}"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="FollowingStatusText"
                                       Text="Free navigation"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <Button x:Name="StopFollowingButton"
                                    Style="{StaticResource QuietButton}"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Click="StopFollowingButton_Click"
                                    ToolTip="Stop following">
                                <fa:IconBlock Icon="Xmark" FontSize="8"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Map command dock -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="270,0,428,20"
                            Padding="5"
                            Background="#E80D100C"
                            BorderBrush="#7A3A4033"
                            BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}"
                                    Width="32"
                                    Height="32"
                                    Click="MapZoomOutButton_Click"
                                    ToolTip="Zoom out">
                                <fa:IconBlock Icon="Minus" FontSize="9"/>
                            </Button>

                            <Border Width="48"
                                    Margin="4,0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0">
                                <TextBlock x:Name="MapZoomText"
                                           Text="100%"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Button Style="{StaticResource IconButton}"
                                    Width="32"
                                    Height="32"
                                    Click="MapZoomInButton_Click"
                                    ToolTip="Zoom in">
                                <fa:IconBlock Icon="Plus" FontSize="9"/>
                            </Button>

                            <Border Width="1"
                                    Height="20"
                                    Margin="8,6"
                                    Background="{StaticResource BorderStrong}"/>

                            <Button Style="{StaticResource IconButton}"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    Click="MapFitButton_Click"
                                    ToolTip="Fit entire reserve">
                                <fa:IconBlock Icon="Expand" FontSize="9"/>
                            </Button>

                            <Button Style="{StaticResource IconButton}"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    Click="MapCenterPlayerButton_Click"
                                    ToolTip="Center on player once">
                                <fa:IconBlock Icon="Crosshairs" FontSize="9"/>
                            </Button>

                            <Button x:Name="FollowPlayerButton"
                                    Style="{StaticResource IconButton}"
                                    Width="32"
                                    Height="32"
                                    Click="FollowPlayerButton_Click"
                                    ToolTip="Follow player continuously">
                                <fa:IconBlock Icon="LocationArrow" FontSize="9"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- POPULATION -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Database" FontSize="13" Width="20" Margin="{StaticResource InlineGap}"/>
                        <TextBlock Text="POPULATION"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="24,0,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Population Scanner" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Dense reserve-wide population data"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="MATCHES" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationMatchText" Text="0 / 0" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="DIAMOND" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationDiamondText" Text="0" Foreground="{StaticResource DiamondBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="RARE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationRareText" Text="0" Foreground="{StaticResource RareBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GREAT ONE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationGreatOneText" Text="0" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1">
                        <WrapPanel VerticalAlignment="Center" Margin="0,12">
                            <ComboBox x:Name="PopulationSpeciesFilter"
                                      Width="170"
                                      Margin="{StaticResource ControlGap}"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <ComboBox x:Name="PopulationTrophyFilter"
                                      Width="125"
                                      Margin="{StaticResource ControlGap}"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <ComboBox x:Name="PopulationDifficultyFilter"
                                      Width="110"
                                      Margin="{StaticResource ControlGap}"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <TextBox x:Name="PopulationFurFilter"
                                     Width="130"
                                     Margin="{StaticResource ControlGap}"
                                     ToolTip="Fur name"
                                     TextChanged="PopulationFilters_Changed"/>
                            <ComboBox x:Name="PopulationSexFilter"
                                      Width="100"
                                      Margin="0,0,14,0"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <CheckBox x:Name="PopulationRareOnly"
                                      Content="Rare"
                                      Margin="0,0,14,0"
                                      Checked="PopulationFilters_Changed"
                                      Unchecked="PopulationFilters_Changed"/>
                            <CheckBox x:Name="PopulationGreatOneOnly"
                                      Content="Great One"
                                      Margin="0,0,14,0"
                                      Checked="PopulationFilters_Changed"
                                      Unchecked="PopulationFilters_Changed"/>
                            <Button Style="{StaticResource QuietButton}"
                                    Click="ClearPopulationFilters_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Rotate" FontSize="10" Margin="{StaticResource InlineGap}"/>
                                    <TextBlock Text="Reset"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,16,0,0">
                        <DataGrid x:Name="PopulationGrid"
                                  AlternationCount="2"
                                  CanUserSortColumns="True"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Species" Binding="{Binding Species}" Width="*"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="70"/>
                                <DataGridTextColumn Header="#" Binding="{Binding Slot}" Width="48"/>
                                <DataGridTextColumn Header="Sex" Binding="{Binding Gender}" Width="70"/>
                                <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="110"/>
                                <DataGridTextColumn Header="Trophy" Binding="{Binding Trophy}" Width="90"/>
                                <DataGridTextColumn Header="Fur" Binding="{Binding Fur}" Width="130"/>
                                <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="80"/>
                                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="86"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:F2}}" Width="82"/>
                                <DataGridTextColumn Header="Seed" Binding="{Binding Seed}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Sliders" FontSize="13" Width="20" Margin="{StaticResource InlineGap}"/>
                        <TextBlock Text="CONTROL CENTER"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,0,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Text="Control Center" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Interface, map setup and scanner diagnostics"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INTERFACE" Style="{StaticResource SectionLabel}" Margin="{StaticResource FieldGap}"/>

                                <CheckBox x:Name="AlwaysOnTopCheck"
                                          Content="Always on top"
                                          Margin="{StaticResource ControlGap}"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowGroupCheck"
                                          Content="Show herd / group identity"
                                          IsChecked="True"
                                          Margin="{StaticResource ControlGap}"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowCoordinatesCheck"
                                          Content="Show world coordinates"
                                          IsChecked="True"
                                          Margin="{StaticResource ControlGap}"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowDeveloperCheck"
                                          Content="Show developer details"
                                          Margin="{StaticResource ControlGap}"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowOutpostsCheck"
                                          Content="Show outpost calibration references on map"
                                          IsChecked="True"
                                          Margin="{StaticResource ControlGap}"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,20"/>

                                <TextBlock Text="MAP SETUP" Style="{StaticResource SectionLabel}" Margin="{StaticResource FieldGap}"/>
                                <TextBlock x:Name="SettingsMapStatusText"
                                           Text="Map setup status"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BuildMapsFromGameButton"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="False"
                                            Click="BuildMapsFromGameButton_Click"
                                            Margin="{StaticResource ControlGap}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="FolderOpen" FontSize="11" Margin="{StaticResource InlineGap}"/>
                                            <TextBlock Text="Build maps from game"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LoadMapImageButton"
                                            Click="LoadMapImageButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="Map" FontSize="11" Margin="{StaticResource InlineGap}"/>
                                            <TextBlock Text="Load map image"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RUNTIME" Style="{StaticResource SectionLabel}" Margin="{StaticResource FieldGap}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Process ID" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsPidText" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="Reserve" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsReserveText" Grid.Row="1" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="Patch" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsPatchText" Grid.Row="2" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="Profile" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsProfileText" Grid.Row="3" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                </Grid>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,20"/>

                                <Expander Header="Diagnostics">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Population file" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="SettingsPopulationPathText"
                                                   Text="—"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14"/>
                                        <TextBlock Text="Executable SHA-256" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="SettingsHashText"
                                                   Text="—"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14"/>
                                        <TextBlock Text="READ-ONLY · VM_READ / QUERY"
                                                   Foreground="{StaticResource GoodBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- STATUS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="CircleInfo" FontSize="13" Width="20" Margin="{StaticResource InlineGap}"/>
                        <TextBlock Text="ABOUT"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24">
                    <StackPanel Width="520" HorizontalAlignment="Left">
                        <TextBlock Text="WildTrace" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="A read-only COTW live radar and population intelligence tool."
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,24"/>
                        <TextBlock Text="DESIGN DIRECTION" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Purpose-built for hunting telemetry: map first, fast target scanning, dense population data only where density is useful."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
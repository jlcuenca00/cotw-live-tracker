<Window x:Class="CotwLiveTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CotwLiveTracker.Desktop.Controls"
        Title="COTW Live Tracker"
        Width="1460"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0D1218"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COTW LIVE TRACKER"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="Read-only population scanner + live radar"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            Background="#3F1F2937"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="0,0,12,0">
                        <TextBlock x:Name="StatusText"
                                   Text="Offline"
                                   Foreground="#CBD5E1"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <ComboBox x:Name="ReserveBox"
                              Width="260"
                              Margin="0,0,10,0"
                              DisplayMemberPath="Name"/>

                    <Button x:Name="AttachButton"
                            Content="Attach / Reload"
                            Click="AttachButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="16"
                    x:Name="MainTabs">
            <TabItem Header="Dashboard">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Rows="1"
                                 Columns="5"
                                 Margin="0,0,0,14">
                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="4">
                            <StackPanel>
                                <TextBlock Text="Loaded animals"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="LoadedCountText"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           FontSize="30"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="4">
                            <StackPanel>
                                <TextBlock Text="Resolved identities"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="ResolvedCountText"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           FontSize="30"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="4">
                            <StackPanel>
                                <TextBlock Text="Diamonds loaded"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="DiamondCountText"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#60A5FA"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="4">
                            <StackPanel>
                                <TextBlock Text="Rare furs loaded"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="RareCountText"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#22D3EE"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="4">
                            <StackPanel>
                                <TextBlock Text="Great Ones loaded"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GreatOneCountText"
                                           Text="0"
                                           Margin="0,6,0,0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#F472B6"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Nearest loaded animals"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,10"/>
                                <DataGrid x:Name="DashboardAnimalsGrid"
                                          AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Distance" Binding="{Binding DistanceText}" Width="90"/>
                                        <DataGridTextColumn Header="Species" Binding="{Binding DisplaySpecies}" Width="*"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Difficulty}" Width="120"/>
                                        <DataGridTextColumn Header="Trophy" Binding="{Binding Trophy}" Width="100"/>
                                        <DataGridTextColumn Header="Fur" Binding="{Binding Fur}" Width="140"/>
                                        <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="Session"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>

                                <TextBlock Text="Reserve"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="DashboardReserveText"
                                           Text="—"
                                           Margin="0,3,0,14"
                                           FontSize="15"/>

                                <TextBlock Text="Camera XYZ"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="CameraPositionText"
                                           Text="—"
                                           Margin="0,3,0,14"
                                           FontFamily="Consolas"/>

                                <TextBlock Text="Population animals"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="PopulationTotalText"
                                           Text="—"
                                           Margin="0,3,0,14"
                                           FontSize="15"/>

                                <TextBlock Text="Runtime status"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="RuntimeStatusText"
                                           Text="Not attached"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Live Radar">
                <Grid Margin="4,12,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="4"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0,0,18,0">
                                    <TextBlock Text="Live map"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MapModeStatusText"
                                               Text="Relative radar fallback"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BuildMapsFromGameButton"
                                            Content="Build maps"
                                            Padding="9,6"
                                            Margin="0,0,6,0"
                                            IsEnabled="False"
                                            Click="BuildMapsFromGameButton_Click"
                                            ToolTip="Extract and cache installed reserve maps directly from your COTW game archives."/>
                                    <Button x:Name="LoadMapImageButton"
                                            Content="Load image"
                                            Padding="9,6"
                                            Margin="0,0,10,0"
                                            Click="LoadMapImageButton_Click"
                                            ToolTip="Manually import a compatible full reserve map image."/>
                                    <TextBlock Text="Range"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Slider x:Name="RadarRangeSlider"
                                            Width="110"
                                            Minimum="250"
                                            Maximum="1500"
                                            Value="1000"
                                            TickFrequency="250"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="RadarRangeSlider_ValueChanged"/>
                                    <TextBlock x:Name="RadarRangeText"
                                               Text="1000 m"
                                               Width="65"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <controls:RadarControl x:Name="Radar"
                                                   Grid.Row="1"
                                                   MinHeight="500"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1"
                          Margin="8,4,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.62*"/>
                            <RowDefinition Height="0.38*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Loaded animals"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,10"/>
                                <DataGrid x:Name="LiveAnimalsGrid"
                                          SelectionMode="Single"
                                          SelectionChanged="LiveAnimalsGrid_SelectionChanged"
                                          AlternationCount="2"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Dist" Binding="{Binding DistanceText}" Width="70"/>
                                        <DataGridTextColumn Header="Species" Binding="{Binding DisplaySpecies}" Width="110"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Difficulty}" Width="95"/>
                                        <DataGridTextColumn Header="Trophy" Binding="{Binding Trophy}" Width="75"/>
                                        <DataGridTextColumn Header="Fur" Binding="{Binding Fur}" Width="95"/>
                                        <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="65"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Selected animal"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="SelectedAnimalTitle"
                                           Text="Click a radar marker or live row"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedAnimalDetails"
                                           Text="Distance, identity, score, fur and XYZ will appear here."
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Population Scanner">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="4,4,4,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBox x:Name="PopulationSpeciesFilter"
                                     Width="150"
                                     Margin="4"
                                     ToolTip="Species contains..."/>
                            <ComboBox x:Name="PopulationTrophyFilter"
                                      Width="125"
                                      Margin="4"/>
                            <ComboBox x:Name="PopulationDifficultyFilter"
                                      Width="115"
                                      Margin="4"/>
                            <TextBox x:Name="PopulationFurFilter"
                                     Width="140"
                                     Margin="4"
                                     ToolTip="Fur contains..."/>
                            <ComboBox x:Name="PopulationSexFilter"
                                      Width="100"
                                      Margin="4"/>
                            <CheckBox x:Name="PopulationRareOnly"
                                      Content="Rare only"
                                      Foreground="{StaticResource TextPrimary}"
                                      Margin="10,7"/>
                            <CheckBox x:Name="PopulationGreatOneOnly"
                                      Content="Great One"
                                      Foreground="{StaticResource TextPrimary}"
                                      Margin="10,7"/>
                            <Button Content="Apply filters"
                                    Margin="8,2"
                                    Click="ApplyPopulationFilters_Click"/>
                            <Button Content="Clear"
                                    Margin="4,2"
                                    Click="ClearPopulationFilters_Click"/>
                        </WrapPanel>
                    </Border>

                    <DockPanel Grid.Row="1"
                               Margin="8,0,8,8">
                        <TextBlock Text="Full reserve population"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="PopulationMatchText"
                                   DockPanel.Dock="Right"
                                   Text="0 matches"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </DockPanel>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8"
                            Margin="4">
                        <DataGrid x:Name="PopulationGrid"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Species" Binding="{Binding Species}" Width="*"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="70"/>
                                <DataGridTextColumn Header="#" Binding="{Binding Slot}" Width="55"/>
                                <DataGridTextColumn Header="Sex" Binding="{Binding Gender}" Width="80"/>
                                <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="120"/>
                                <DataGridTextColumn Header="Trophy" Binding="{Binding Trophy}" Width="95"/>
                                <DataGridTextColumn Header="Fur" Binding="{Binding Fur}" Width="140"/>
                                <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="90"/>
                                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="85"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:F2}}" Width="85"/>
                                <DataGridTextColumn Header="Seed" Binding="{Binding Seed}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings / Status">
                <Grid Margin="4,12,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="4">
                        <StackPanel>
                            <TextBlock Text="Runtime"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Process ID" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SettingsPidText" Text="—" Margin="0,3,0,12"/>

                            <TextBlock Text="Reserve" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SettingsReserveText" Text="—" Margin="0,3,0,12"/>

                            <TextBlock Text="Population file" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SettingsPopulationPathText"
                                       Text="—"
                                       Margin="0,3,0,12"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"/>

                            <TextBlock Text="Access mode" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="READ-ONLY · VM_READ / query only"
                                       Foreground="{StaticResource GoodBrush}"
                                       Margin="0,3,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="8,4,4,4">
                        <StackPanel>
                            <TextBlock Text="Patch profile"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Profile" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SettingsProfileText"
                                       Text="—"
                                       Margin="0,3,0,12"/>

                            <TextBlock Text="Game patch" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SettingsPatchText"
                                       Text="—"
                                       Margin="0,3,0,12"/>

                            <TextBlock Text="Executable SHA-256" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SettingsHashText"
                                       Text="—"
                                       Margin="0,3,0,12"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"/>

                            <TextBlock Text="Live metadata offsets" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Weight +0x19C · Score +0x1A0 · Visual seed +0x1B0"
                                       Margin="0,3,0,0"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

<Window x:Class="CotwLiveTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CotwLiveTracker.Desktop.Controls"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="WildTrace — COTW Scanner"
        Width="1540"
        Height="920"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Global chrome -->
        <Border Grid.Row="0"
                Background="#0E100D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            Background="{StaticResource AccentMuted}"
                            BorderBrush="#58401F"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,10,0">
                        <fa:IconBlock Icon="Paw"
                                      Foreground="{StaticResource AccentBright}"
                                      FontSize="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WILDTRACE"
                                   FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock Text="COTW SCANNER"
                                   Foreground="{StaticResource TextFaint}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            Background="#171A14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource TextFaint}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Offline"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Grid Width="286" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:IconBlock Icon="Map"
                                      Foreground="{StaticResource AccentBrush}"
                                      FontSize="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Panel.ZIndex="2"/>
                        <ComboBox x:Name="ReserveBox"
                                  Grid.ColumnSpan="2"
                                  Padding="32,6,9,6"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ReserveBox_SelectionChanged"/>
                    </Grid>

                    <Button x:Name="AttachButton"
                            Style="{StaticResource PrimaryButton}"
                            Click="AttachButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plug" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock Text="Attach"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="MainTabs"
                    TabStripPlacement="Left"
                    SelectedIndex="1">
            <!-- Kept only for existing session bindings; intentionally hidden from navigation. -->
            <TabItem Header="Dashboard" Visibility="Collapsed">
                <Grid Visibility="Collapsed">
                    <TextBlock x:Name="LoadedCountText"/>
                    <TextBlock x:Name="ResolvedCountText"/>
                    <TextBlock x:Name="DiamondCountText"/>
                    <TextBlock x:Name="RareCountText"/>
                    <TextBlock x:Name="GreatOneCountText"/>
                    <TextBlock x:Name="DashboardReserveText"/>
                    <TextBlock x:Name="CameraPositionText"/>
                    <TextBlock x:Name="PopulationTotalText"/>
                    <TextBlock x:Name="RuntimeStatusText"/>
                    <DataGrid x:Name="DashboardAnimalsGrid"/>
                </Grid>
            </TabItem>

            <!-- LIVE MAP -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Map" FontSize="13" Width="20" Margin="0,0,10,0"/>
                        <TextBlock Text="LIVE MAP"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Background="{StaticResource AppBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Live Map" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Loaded animals, live positions and target tracking"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ALL LOADED"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveFilterSummaryText"
                                       Text="0 shown / 0 loaded"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- FILTER RAIL -->
                        <Border Grid.Column="0"
                                Background="{StaticResource SidebarBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,15">
                                    <Grid Margin="0,0,0,18">
                                        <fa:IconBlock Icon="MagnifyingGlass"
                                                      Foreground="{StaticResource TextFaint}"
                                                      FontSize="11"
                                                      Margin="10,0,0,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Panel.ZIndex="2"/>
                                        <TextBox x:Name="LiveSearchFilter"
                                                 Padding="31,6,8,6"
                                                 ToolTip="Search species, fur, trophy, sex or level"
                                                 TextChanged="LiveFilters_Changed"/>
                                        <TextBlock Text="Search animals"
                                                   Foreground="{StaticResource TextFaint}"
                                                   FontSize="10"
                                                   Margin="31,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=LiveSearchFilter}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Text="SPECIES" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveSpeciesFilter"
                                              Margin="0,0,0,13"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="TROPHY" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveTrophyFilter"
                                              Margin="0,0,0,13"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="DIFFICULTY" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveDifficultyFilter"
                                              Margin="0,0,0,13"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="FUR TYPE" Style="{StaticResource SectionLabel}"/>
                                    <TextBox x:Name="LiveFurFilter"
                                             Margin="0,0,0,13"
                                             ToolTip="Filter by fur name"
                                             TextChanged="LiveFilters_Changed"/>

                                    <TextBlock Text="SEX" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="LiveSexFilter"
                                              Margin="0,0,0,16"
                                              SelectionChanged="LiveFilters_Changed"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,1,0,14"/>

                                    <CheckBox x:Name="LiveRareOnly"
                                              Content="Rare fur only"
                                              Margin="0,0,0,10"
                                              Checked="LiveFilters_Changed"
                                              Unchecked="LiveFilters_Changed"/>
                                    <CheckBox x:Name="LiveGreatOneOnly"
                                              Content="Great One only"
                                              Margin="0,0,0,16"
                                              Checked="LiveFilters_Changed"
                                              Unchecked="LiveFilters_Changed"/>

                                    <WrapPanel x:Name="ActiveFilterChipsPanel"
                                               Margin="0,0,0,5"/>
                                    <TextBlock x:Name="NoActiveFiltersText"
                                               Text="No active filters"
                                               Foreground="{StaticResource TextFaint}"
                                               FontSize="10"
                                               Margin="0,0,0,8"/>

                                    <Button Style="{StaticResource QuietButton}"
                                            HorizontalContentAlignment="Left"
                                            Padding="0,6"
                                            Click="ClearLiveFilters_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="Rotate" FontSize="10" Margin="0,0,7,0"/>
                                            <TextBlock Text="Reset filters" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- MAP -->
                        <Grid Grid.Column="1"
                              Background="#080A07"
                              ClipToBounds="True">
                            <controls:RadarControl x:Name="Radar"
                                                   MinWidth="360"/>

                            <!-- Map identity -->
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="14"
                                    Padding="10,8"
                                    Background="#D90D100C"
                                    BorderBrush="#70343B2F"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock x:Name="MapModeStatusText"
                                               Text="Reserve map"
                                               FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock Text="LIVE RADAR"
                                               Foreground="{StaticResource TextFaint}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Follow status -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,14,0,0"
                                    Padding="10,7"
                                    Background="#E60D100C"
                                    BorderBrush="#70413B2B"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Crosshairs"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  FontSize="11"
                                                  Margin="0,0,7,0"/>
                                    <TextBlock x:Name="FollowingStatusText"
                                               Text="Free navigation"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <Button x:Name="StopFollowingButton"
                                            Style="{StaticResource QuietButton}"
                                            Width="26"
                                            Height="22"
                                            Padding="0"
                                            Margin="8,-4,-5,-4"
                                            IsEnabled="False"
                                            Click="StopFollowingButton_Click"
                                            ToolTip="Stop following">
                                        <fa:IconBlock Icon="Xmark" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Floating map controls -->
                            <StackPanel HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,14,14,0">
                                <Button Style="{StaticResource IconButton}"
                                        Margin="0,0,0,5"
                                        Click="MapZoomInButton_Click"
                                        ToolTip="Zoom in">
                                    <fa:IconBlock Icon="Plus" FontSize="11"/>
                                </Button>
                                <Border Background="#D90D100C"
                                        BorderBrush="#703A4033"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="3"
                                        Margin="0,0,0,5">
                                    <TextBlock x:Name="MapZoomText"
                                               Text="100%"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="9"
                                               TextAlignment="Center"/>
                                </Border>
                                <Button Style="{StaticResource IconButton}"
                                        Margin="0,0,0,5"
                                        Click="MapZoomOutButton_Click"
                                        ToolTip="Zoom out">
                                    <fa:IconBlock Icon="Minus" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Margin="0,0,0,5"
                                        Click="MapFitButton_Click"
                                        ToolTip="Fit entire reserve">
                                    <fa:IconBlock Icon="Expand" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Margin="0,0,0,5"
                                        Click="MapCenterPlayerButton_Click"
                                        ToolTip="Center on player once">
                                    <fa:IconBlock Icon="Crosshairs" FontSize="11"/>
                                </Button>
                                <Button x:Name="FollowPlayerButton"
                                        Style="{StaticResource IconButton}"
                                        Click="FollowPlayerButton_Click"
                                        ToolTip="Follow player continuously">
                                    <fa:IconBlock Icon="LocationArrow" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- INSPECTOR + LOADED LIST -->
                        <Grid Grid.Column="2"
                              Background="{StaticResource SidebarBackground}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="304"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,1,0,1"
                                    Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="SELECTED ANIMAL" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedAnimalTitle"
                                                       Text="Select an animal"
                                                       FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                       FontWeight="SemiBold"
                                                       FontSize="19"/>
                                            <TextBlock x:Name="SelectedDistanceText"
                                                       Text="Click a marker or loaded animal"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="FollowSelectedAnimalButton"
                                                Grid.Column="1"
                                                Style="{StaticResource PrimaryButton}"
                                                Width="38"
                                                Height="34"
                                                Padding="0"
                                                IsEnabled="False"
                                                Click="FollowSelectedAnimalButton_Click"
                                                ToolTip="Follow selected animal">
                                            <fa:IconBlock Icon="Crosshairs" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="SelectedBadgesPanel"
                                                Grid.Row="1"
                                                Orientation="Horizontal"
                                                Margin="0,13,0,13"
                                                Visibility="Collapsed">
                                        <Border Background="#181B15"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4"
                                                Margin="0,0,6,0">
                                            <TextBlock x:Name="SelectedGenderText"
                                                       Text="—"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#181B15"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4"
                                                Margin="0,0,6,0">
                                            <TextBlock x:Name="SelectedDifficultyText"
                                                       Text="—"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <Border x:Name="SelectedTrophyBadge"
                                                Background="#181B15"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4">
                                            <TextBlock x:Name="SelectedTrophyText"
                                                       Text="—"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <Grid x:Name="SelectedMetricsGrid"
                                          Grid.Row="2"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="TROPHY SCORE" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedScoreText" Text="—" Style="{StaticResource MetricValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="WEIGHT" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedWeightText" Text="—" Style="{StaticResource MetricValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,12,0">
                                            <TextBlock Text="FUR" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedFurText"
                                                       Text="—"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="HEALTH" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedHealthText"
                                                       Text="—"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="SelectedFooterPanel"
                                                Grid.Row="3"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="SelectedThresholdText"
                                                   Text="Select an animal to see trophy threshold context."
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                        <Expander x:Name="SelectedTechnicalPanel"
                                                  Header="Developer details"
                                                  Visibility="Collapsed"
                                                  Margin="0,8,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock x:Name="SelectedTechnicalText"
                                                           Text="—"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"/>
                                                <Button Content="Probe native level"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        Click="ProbeDifficultyButton_Click"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="45"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="13,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <fa:IconBlock Icon="Paw"
                                                          Foreground="{StaticResource AccentBrush}"
                                                          FontSize="11"
                                                          Margin="0,0,8,0"/>
                                            <TextBlock Text="LOADED ANIMALS"
                                                       FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="double-click to follow"
                                                   Foreground="{StaticResource TextFaint}"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataGrid x:Name="LiveAnimalsGrid"
                                              Grid.Row="1"
                                              SelectionMode="Single"
                                              SelectionChanged="LiveAnimalsGrid_SelectionChanged"
                                              MouseDoubleClick="LiveAnimalsGrid_MouseDoubleClick"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Species" Binding="{Binding DisplaySpecies}" Width="*"/>
                                            <DataGridTextColumn Header="Level" Binding="{Binding Difficulty}" Width="78"/>
                                            <DataGridTextColumn Header="Trophy" Binding="{Binding Trophy}" Width="72"/>
                                            <DataGridTextColumn Header="Dist" Binding="{Binding DistanceText}" Width="62"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- POPULATION -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Database" FontSize="13" Width="20" Margin="0,0,10,0"/>
                        <TextBlock Text="POPULATION"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="18,0,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Population Scanner" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Dense reserve-wide population data"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="MATCHES" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationMatchText" Text="0 / 0" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="DIAMOND" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationDiamondText" Text="0" Foreground="{StaticResource DiamondBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="RARE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationRareText" Text="0" Foreground="{StaticResource RareBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GREAT ONE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="PopulationGreatOneText" Text="0" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1">
                        <WrapPanel VerticalAlignment="Center" Margin="0,11">
                            <ComboBox x:Name="PopulationSpeciesFilter"
                                      Width="170"
                                      Margin="0,0,8,0"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <ComboBox x:Name="PopulationTrophyFilter"
                                      Width="125"
                                      Margin="0,0,8,0"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <ComboBox x:Name="PopulationDifficultyFilter"
                                      Width="110"
                                      Margin="0,0,8,0"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <TextBox x:Name="PopulationFurFilter"
                                     Width="130"
                                     Margin="0,0,8,0"
                                     ToolTip="Fur name"
                                     TextChanged="PopulationFilters_Changed"/>
                            <ComboBox x:Name="PopulationSexFilter"
                                      Width="100"
                                      Margin="0,0,12,0"
                                      SelectionChanged="PopulationFilters_Changed"/>
                            <CheckBox x:Name="PopulationRareOnly"
                                      Content="Rare"
                                      Margin="0,0,12,0"
                                      Checked="PopulationFilters_Changed"
                                      Unchecked="PopulationFilters_Changed"/>
                            <CheckBox x:Name="PopulationGreatOneOnly"
                                      Content="Great One"
                                      Margin="0,0,12,0"
                                      Checked="PopulationFilters_Changed"
                                      Unchecked="PopulationFilters_Changed"/>
                            <Button Style="{StaticResource QuietButton}"
                                    Click="ClearPopulationFilters_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Rotate" FontSize="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="Reset"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,12,0,0">
                        <DataGrid x:Name="PopulationGrid"
                                  AlternationCount="2"
                                  CanUserSortColumns="True"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Species" Binding="{Binding Species}" Width="*"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="70"/>
                                <DataGridTextColumn Header="#" Binding="{Binding Slot}" Width="48"/>
                                <DataGridTextColumn Header="Sex" Binding="{Binding Gender}" Width="70"/>
                                <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="110"/>
                                <DataGridTextColumn Header="Trophy" Binding="{Binding Trophy}" Width="90"/>
                                <DataGridTextColumn Header="Fur" Binding="{Binding Fur}" Width="130"/>
                                <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="80"/>
                                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="86"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:F2}}" Width="82"/>
                                <DataGridTextColumn Header="Seed" Binding="{Binding Seed}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Sliders" FontSize="13" Width="20" Margin="0,0,10,0"/>
                        <TextBlock Text="CONTROL CENTER"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18,0,18,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Text="Control Center" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Interface, map setup and scanner diagnostics"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INTERFACE" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>

                                <CheckBox x:Name="AlwaysOnTopCheck"
                                          Content="Always on top"
                                          Margin="0,0,0,12"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowGroupCheck"
                                          Content="Show herd / group identity"
                                          IsChecked="True"
                                          Margin="0,0,0,12"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowCoordinatesCheck"
                                          Content="Show world coordinates"
                                          IsChecked="True"
                                          Margin="0,0,0,12"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowDeveloperCheck"
                                          Content="Show developer details"
                                          Margin="0,0,0,12"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>
                                <CheckBox x:Name="ShowOutpostsCheck"
                                          Content="Show outpost calibration references on map"
                                          IsChecked="True"
                                          Margin="0,0,0,12"
                                          Checked="InterfaceSettings_Changed"
                                          Unchecked="InterfaceSettings_Changed"/>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,18"/>

                                <TextBlock Text="MAP SETUP" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="SettingsMapStatusText"
                                           Text="Map setup status"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BuildMapsFromGameButton"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="False"
                                            Click="BuildMapsFromGameButton_Click"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="FolderOpen" FontSize="11" Margin="0,0,7,0"/>
                                            <TextBlock Text="Build maps from game"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LoadMapImageButton"
                                            Click="LoadMapImageButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="Map" FontSize="11" Margin="0,0,7,0"/>
                                            <TextBlock Text="Load map image"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RUNTIME" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Process ID" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsPidText" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="Reserve" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsReserveText" Grid.Row="1" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="Patch" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsPatchText" Grid.Row="2" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="Profile" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SettingsProfileText" Grid.Row="3" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                </Grid>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,18"/>

                                <Expander Header="Diagnostics">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Population file" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="SettingsPopulationPathText"
                                                   Text="—"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="Executable SHA-256" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="SettingsHashText"
                                                   Text="—"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="READ-ONLY · VM_READ / QUERY"
                                                   Foreground="{StaticResource GoodBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- STATUS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="CircleInfo" FontSize="13" Width="20" Margin="0,0,10,0"/>
                        <TextBlock Text="ABOUT"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24">
                    <StackPanel Width="520" HorizontalAlignment="Left">
                        <TextBlock Text="WildTrace" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="A read-only COTW live radar and population intelligence tool."
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,22"/>
                        <TextBlock Text="DESIGN DIRECTION" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Purpose-built for hunting telemetry: map first, fast target scanning, dense population data only where density is useful."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>